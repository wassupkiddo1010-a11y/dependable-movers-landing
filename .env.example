NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional — paste the content value from Google Search Console verification
# GOOGLE_SITE_VERIFICATION=your-verification-token

# Formspree contact form endpoint (/contact/ page)
NEXT_PUBLIC_FORMSPREE_CONTACT_URL=https://formspree.io/f/your-form-id

# Quote form → n8n lead intake (required in production unless Supabase is configured)
N8N_QUOTE_WEBHOOK_URL=https://your-n8n-instance/webhook/your-path

# Newsletter subscribe (optional separate webhook)
# N8N_SUBSCRIBE_WEBHOOK_URL=https://your-n8n-instance/webhook/...

# Supabase (server-only — never expose service role key to the client)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_QUOTE_TABLE=quote_leads
# SUPABASE_SUBSCRIBE_TABLE=newsletter_subscribers
